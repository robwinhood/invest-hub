root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_standard_trailing-comma-on-call-site = always
ktlint_standard_trailing-comma-on-declaration-site = always
# Kotlin 예약어(in)를 backtick으로 escape한 패키지명 허용 (adapter.`in`.web)
ktlint_standard_package-name = disabled
# AtomicBoolean 내부 상태 backing property 패턴 허용 (_completed, _running)
ktlint_standard_backing-property-naming = disabled

[*.yml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
